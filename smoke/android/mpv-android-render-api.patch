+static bool set_pq_dataspace(ANativeWindow *window)
+{
+    using set_buffers_dataspace_fn = int32_t (*)(ANativeWindow *, int32_t);
+    void *lib = dlopen("libnativewindow.so", RTLD_NOW | RTLD_LOCAL);
+    set_buffers_dataspace_fn set_buffers_dataspace =
+        reinterpret_cast<set_buffers_dataspace_fn>(
+            lib ? dlsym(lib, "ANativeWindow_setBuffersDataSpace") : nullptr);
+    if (!set_buffers_dataspace) {
+        ALOGE("PQ unsupported: missing native-window dataspace API");
+        if (lib)
+            dlclose(lib);
+        return false;
+    }
+
+    int error = set_buffers_dataspace(window, ADATASPACE_BT2020_PQ);
+    dlclose(lib);
+    if (error)
+        ALOGE("BT.2020/PQ dataspace failed: %d", error);
