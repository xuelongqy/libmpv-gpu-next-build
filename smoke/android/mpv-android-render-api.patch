+static bool has_extension(const char *extensions, const char *name)
+{
+    size_t len = strlen(name);
+    for (const char *p = extensions; p && (p = strstr(p, name)); p += len) {
+        if ((p == extensions || p[-1] == ' ') &&
+            (p[len] == '\0' || p[len] == ' '))
+            return true;
+    }
+    return false;
+}
